# 豆包语音配置模板
#
# 用法：复制成 .env（和本文件同级），填好即可，命令行不用再带 --api-key / --speaker。
# 生效优先级：命令行参数 > 进程环境变量 > .env（离工作目录越近的 .env 优先）。
# 查询当前生效的配置：python scripts/doubao_tts.py --config

# API Key：控制台 → 语音技术 → 豆包语音 → 接入管理 → API Key
DOUBAO_API_KEY=

# 音色 ID：控制台 → 豆包语音 → 音色库 → 复制音色 ID
# 复刻音色填 voice_clone.py register 注册出来的 speaker ID
DOUBAO_SPEAKER=

# 模型资源 ID
#   seed-icl-2.0 = 豆包声音复刻大模型 2.0（默认，配复刻音色）
#   seed-tts-2.0 = 豆包语音合成大模型 2.0（预置音色）
DOUBAO_RESOURCE_ID=seed-icl-2.0

# 复刻音色版本：auto / standard / expressive / none
# expressive = 表现力增强版；none = 不传 model（仅预置音色用）
DOUBAO_MODEL=auto

# 音色克隆时用的默认音色代号（可选）
DOUBAO_SPEAKER_ID=
DOUBAO_CUSTOM_SPEAKER_ID=
